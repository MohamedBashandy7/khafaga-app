
{
    "appId": "com.blackpearl.infinitycode.accounting",
    "productName": "Fresh Invoices Writer",
    "extraResources": ["dist-electron/preload.cjs"],
    "directories": {
        "output": "dist"
    },
    "files": ["dist-electron/**/*", "dist-react/**/*"],
    "win": {
        "icon": "src/assets/app-icon.ico",
        "target": ["nsis"]
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Fresh Invoices Writer",
        "include": "build/installer.nsh"
    },
    "mac": {
        "target": "dmg"
    },
    "linux": {
        "target": ["AppImage", "deb"],
        "category": "Utility"
    }
}
