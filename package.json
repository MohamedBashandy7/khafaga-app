{
    "name": "accounting",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist-electron/main.js",
    "description": "A commercial desktop accounting solution for managing financial transactions, CRM, and ERP.",
    "author": "Mohamed Salah Bashandy",
    "scripts": {
        "dev": "npm-run-all --parallel dev:react electron",
        "dev:react": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "electron:build": "tsc -p src/electron/tsconfig.json",
        "electron": "npm run electron:build && cross-env NODE_ENV=development electron .",
        "electron:build:win": "npm run electron:build && npm run build && electron-builder --win --x64",
        "electron:build:mac": "npm run electron:build && npm run build && electron-builder --mac --arm64",
        "electron:build:linux": "npm run electron:build && npm run build && electron-builder --linux --x64"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.2",
        "electron-store": "^11.0.2",
        "lucide-react": "^1.24.0",
        "material-design-iconic-font": "^2.2.0",
        "os-utils": "^0.0.14",
        "pace-js": "^1.2.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.1",
        "recharts": "^3.9.2",
        "sweetalert2": "^11.26.25",
        "tailwindcss": "^4.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/os-utils": "^0.0.4",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "cross-env": "^10.1.0",
        "electron": "^42.5.0",
        "electron-builder": "^26.15.3",
        "eslint": "^10.5.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "npm-run-all": "^4.1.5",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.61.0",
        "vite": "^8.1.0"
    }
}
